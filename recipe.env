# GLM-5.3-Flash EXL3 on 2x GB10 (GX10 or DGX Spark, any mix) — the only file you edit.
#
# run.sh composes the kit's .env as: <kit>/.env.example, then this file on top
# (later assignments win). Anything not set here keeps the kit's default.

# --- kit pin -------------------------------------------------------------------
KIT_REPO=https://github.com/MiaAI-Lab/GLM-5.3-Flash-EXL3-2x-DGX-Sparks.git
KIT_COMMIT=70b2f33          # main on 2026-09-26, includes #251 (auto loader, APC fixes)

# --- your two nodes (EDIT) ------------------------------------------------------
HEAD_IP=10.44.0.2           # head's rail-1 ConnectX address
WORKER_IP=10.44.0.1         # worker's rail-1 ConnectX address
WORKER_USER=youruser        # SSH user on the worker
WORKER_HOME=/home/youruser
WORKER_SSH=youruser@10.44.0.1
# 1 = worker runs docker through passwordless sudo (no docker-group membership needed)
WORKER_DOCKER_SUDO=1
# 1 = head runs docker through passwordless sudo too (run.sh wraps the launcher)
HEAD_DOCKER_SUDO=1
# Where the API listens. 0.0.0.0 = every interface; set a tailnet/LAN address to
# restrict it (health checks and banners follow it).
BIND_HOST=0.0.0.0

# --- dual-rail ConnectX-7 fabric ------------------------------------------------
# Both rails, comma list, no '=' prefix ('=a,=b' silently engages only the first).
HEAD_CX7_IF=enp1s0f0np0
WORKER_CX7_IF=enp1s0f0np0
HEAD_CX7_IB=rocep1s0f0,roceP2p1s0f0
WORKER_CX7_IB=rocep1s0f0,roceP2p1s0f0
# EMPTY = NCCL per-HCA RoCEv2 GID auto-selection. A pinned index breaks when
# rail-2's GID table shifts after a reboot ("NCCL unhandled system error").
NCCL_IB_GID_INDEX=
NCCL_NCHANNELS=8

# --- weights / drafter (kit defaults, pinned) ------------------------------------
MODEL=Mia-AiLab/GLM-5.3-Flash-EXL3-TR3-4bpw
MODEL_REVISION=25a44fdbf16862a46b7cc9921142c6c81350af2f
SPEC_METHOD=dflash
DFLASH_MODEL=incoai/GLM-5.3-Flash-DFlash2
DFLASH_REVISION=dc77ff1c99eeb2df044ee3d4f0094eb033fee410
DFLASH_TOKENS=7

# --- image ------------------------------------------------------------------------
# Built locally from the pinned kit's Dockerfile on first run (the published GHCR
# image predates the FAST decode kernel and #251). run.sh ships it to the worker.
IMAGE=glm53-flash:recipe-70b2f33

# --- the tuning (what this recipe is) ------------------------------------------------
# Loader: auto/lazy (#251) — ~300 s boots, ~0 swap during load.
LOAD_FORMAT=
# Decode: TP1 drafter, adaptive verification length, FP8 dense/KDA projections,
# FAST thin-decode MoE kernel (needs the locally built image).
DFLASH_DRAFT_TP=1
GLM53_ADAPTIVE_K=ema
GLM53_ADAPTIVE_K_SET=2,4,7
GLM53_DENSE_FP8=dense,kda
GLM53_EXL3_MOE_FAST=1
# Prefill: FP8 KDA costs ~12% prefill on its own — this BF16 large-M path gives it
# back (decode unchanged, +3.3 GiB/rank).
GLM53_KDA_BF16_LARGE_M=1
MAX_NUM_BATCHED_TOKENS=7168
# Context / memory
MAX_MODEL_LEN=850000
MAX_NUM_SEQS=4
GPU_MEM_UTIL=0.85
KV_CACHE_DTYPE=fp8
EXTRA_ARGS="--kv-cache-memory-bytes 15032385536"
